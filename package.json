{
  "name": "defaultstackr",
  "version": "0.1.0",
  "private": true,
  "description": "DefaultStackr by CodedByDefault, a landing page for the platform in development.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "start:next": "next start -H 127.0.0.1 -p 3100",
    "lint": "tsc --noEmit --pretty false",
    "test": "node scripts/tests/platform.mjs && node scripts/tests/dashboard.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/onest": "^5.3.1",
    "@fontsource/outfit": "^5.3.0",
    "better-auth": "^1.7.25",
    "next": "^15.5.12",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}

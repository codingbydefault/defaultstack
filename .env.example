# Express on the SAME machine as the Next.js server. Never a browser-visible variable.
DATABASE_API_URL=http://127.0.0.1:3000
# Opt in only while Next.js is reachable exclusively from your private network.
ENABLE_LOCAL_DATABASE_EDITOR=false
# Optional read-only deployment snapshot, exported by the deploy user.
# DEFAULTSTACK_STATE_DIR=/home/coded/.local/state/defaultstack

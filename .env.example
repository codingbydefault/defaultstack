# Express on the SAME machine as the Next.js server. Never a browser-visible variable.
DATABASE_API_URL=http://127.0.0.1:3000
# Opt in only while Next.js is reachable exclusively from your private network.
ENABLE_LOCAL_DATABASE_EDITOR=false
# Optional read-only deployment snapshot, exported by the deploy user.
# DEFAULTSTACK_STATE_DIR=/home/coded/.local/state/defaultstack

# Server-only dashboard settings. Never prefix these with NEXT_PUBLIC_.
# DEFAULTSTACKR_API_URL=http://127.0.0.1:3000
# DEFAULTSTACKR_API_KEY=
# DEFAULTSTACKR_ADMIN_PASSWORD_HASH=
# DEFAULTSTACKR_SESSION_SECRET=
# DEFAULTSTACKR_MOCK=false
# DEFAULTSTACKR_EDGE_CNAME=edge.defaultstackr.cloud
# DEFAULTSTACKR_EDGE_IPV4=

# GitHub App: OAuth callback https://www.defaultstackr.cloud/api/github/callback.
# Give the app Metadata: read and Contents: read and write for the code editor; install only on selected repositories.
# DEFAULTSTACKR_PUBLIC_URL=https://www.defaultstackr.cloud
# DEFAULTSTACKR_GITHUB_CLIENT_ID=
# DEFAULTSTACKR_GITHUB_CLIENT_SECRET=
# DEFAULTSTACKR_GITHUB_APP_SLUG=
# Customer accounts, moderated reviews and aggregate analytics use the platform PostgreSQL database.
# Apply migrations through 006 before enabling the review and analytics routes.
# These are server-only. Keep the auth secret separate from the admin session secret.
# DEFAULTSTACKR_AUTH_DATABASE_URL=postgresql://auth_user:password@127.0.0.1:5432/platform_database
# DEFAULTSTACKR_AUTH_SECRET=
# DEFAULTSTACKR_GOOGLE_CLIENT_ID=
# DEFAULTSTACKR_GOOGLE_CLIENT_SECRET=
# GitHub customer callback: https://www.defaultstackr.cloud/api/auth/callback/github
# Google callback: https://www.defaultstackr.cloud/api/auth/callback/google
# Sign-in OAuth App (separate from the GitHub App above). Scopes are read:user and user:email.
# Register the callback exactly, then set the same origin as GITHUB_OAUTH_REDIRECT_BASE:
#   https://defaultstack.vercel.app/api/auth/github/callback
#   http://localhost:3000/api/auth/github/callback
# A later custom domain uses that origin plus /api/auth/github/callback.
# When these are unset, the sign-in button stays hidden. Placeholders only:
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# GITHUB_OAUTH_REDIRECT_BASE=https://defaultstack.vercel.app
